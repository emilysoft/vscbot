    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "discord.js-embed-pagination": "^1.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "eslint-plugin-prettier": "^5.5.7",
    "express": "^5.3.0",
    "fb-downloader-scrapper": "^3.0.1",
    "i": "^0.3.7",
    "instagram-url-direct": "^2.0.7",
    "jimp": "^1.6.1",
