    "db:studio": "drizzle-kit studio",
    "deploy-commands": "node src/handlers/deploy-commands.ts",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "clear": "rm -rf dist/**"
  },
  "keywords": [],
  "type": "module",
  "author": "",
  "license": "ISC",
