    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "pnpm": "^10.34.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0"
